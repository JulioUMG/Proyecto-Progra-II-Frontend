server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Esta ruta comprueba que el servidor del frontend está encendido.
    location = /salud {
        access_log off;
        default_type text/plain;
        return 200 'OK';
    }

    # Conserva la ruta, las cookies y el token de los formularios.
    # BACKEND_HOST contiene solo el dominio, sin https:// ni barra final.
    location ~ ^/(api|usuarios|perfiles|huespedes|habitaciones|reservaciones|detalle-reservacion)(/|$) {
        proxy_pass https://${BACKEND_HOST};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 30s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_cache off;
    }

    # Permite recargar /login o /sistema sin perder las rutas de React.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
